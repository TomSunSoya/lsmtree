{
  "version": 6,
  "configurePresets": [
    {
      "name": "modules",
      "displayName": "Named modules with import std (Homebrew LLVM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-std",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_EXPERIMENTAL_CXX_IMPORT_STD": "451f2fe2-a8a2-47c3-bc32-94786d8fc91b",
        "CMAKE_EXE_LINKER_FLAGS": "-L/opt/homebrew/opt/llvm/lib/c++ -Wl,-rpath,/opt/homebrew/opt/llvm/lib/c++",
        "CMAKE_CXX_MODULE_STD": "ON",
        "CMAKE_CXX_STDLIB_MODULES_JSON": "/opt/homebrew/opt/llvm/lib/c++/libc++.modules.json",
        "GTest_DIR": "/opt/homebrew/opt/googletest/lib/cmake/GTest"
      }
    }
  ]
}
